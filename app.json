{
  "expo": {
    "name": "CrecheApp",
    "slug": "CrecheApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "crecheapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "notification": {
      "vapidPublicKey": "BMoEmfnBAMNj17YLZsgTyh6a-eYccHXgZy5KqMZ8Vc9lh1rvl1NV6uc-7JUn2DjcKC0U55XipmxIFOnHBNcxBdU",
      "serviceWorkerPath": "./expo-service-worker.js"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.souiria.CrecheApp",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "display": "standalone"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fd75764c-a292-4621-92c4-f0e764845de5"
      }
    }
  }
}
